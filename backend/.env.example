AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Deterministic engines behind the specialist agents (live mode).
# Leave blank to keep agents on mock data. See docs/integration-engines.md.
# Demand Planning agent  -> incoming-sales-booking-curve (serve.py)
FORECAST_ENGINE_URL=
# Supply Chain Optimizer agent -> fg-planning-optimizer (backend FastAPI)
OPTIMIZER_ENGINE_URL=
# Max seconds to wait for a MILP solve before falling back to mock (default 180)
OPTIMIZER_MAX_WAIT_SEC=180
# Optional master-data crosswalk for the forecast->optimizer chain:
# a CSV with columns sales_model_code,Material
GRAIN_CROSSWALK_CSV=